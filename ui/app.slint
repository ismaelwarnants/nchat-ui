// nchat-ui main window.

import { ListView, ScrollView, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, IconButton, PrimaryButton, Chip, MenuRow, MenuSurface, Backdrop } from "widgets.slint";
import { SetupView, SetupState, SetupProto } from "setup.slint";
import { SettingsView, SettingsState, AccountItem } from "settings.slint";

export { Theme, SetupState, SetupProto, SettingsState, AccountItem }

export struct ChatItem {
    key: string,
    name: string,
    initials: string,
    avatar-color: color,
    preview: string,
    time: string,
    unread: bool,
    unread-count: int,
    muted: bool,
    pinned: bool,
    archived: bool,
    typing: bool,
    selected: bool,
    can-pin: bool,
    can-archive: bool,
}

// kind: 0 = message, 1 = date separator, 2 = "load older" row
export struct MsgItem {
    kind: int,
    id: string,
    text: string,
    rich: styled-text,
    time: string,
    outgoing: bool,
    // 0 none, 1 sent, 2 read
    status: int,
    sender: string,
    sender-color: color,
    show-sender: bool,
    quoted-id-visible: bool,
    quoted-sender: string,
    quoted-text: string,
    has-file: bool,
    file-name: string,
    // 0 document, 1 image, 2 audio, 3 video
    file-kind: int,
    // -1 none, 0 not downloaded, 1 downloaded, 2 downloading, 3 failed
    file-status: int,
    file-note: string,
    file-available: bool,
    is-image: bool,
    is-sticker: bool,
    // audio player: 0 idle, 1 playing, 2 paused, 3 loading
    audio-state: int,
    audio-progress: float,
    audio-time: string,
    audio-speed: string,
    image: image,
    reactions: string,
    deleted: bool,
    edited: bool,
    pinned: bool,
    group-start: bool,
    highlight: bool,
    has-link: bool,
    can-pin: bool,
}

// people / chats in pickers and member lists
export struct PickItem {
    key: string,
    name: string,
    initials: string,
    avatar-color: color,
    subtitle: string,
}

export global InfoState {
    in property <bool> visible: false;
    in property <string> name;
    in property <string> initials;
    in property <color> avatar-color: gray;
    in property <string> subtitle;
    in property <string> phone;
    in property <string> id;
    in property <string> account;
    in property <bool> is-group;
    in property <[PickItem]> members;
    in property <bool> pinned;
    in property <bool> archived;
    in property <bool> can-pin;
    in property <bool> can-archive;
    in property <bool> can-pin-message;
    in property <int> media-count;
    callback close();
    callback action(string);
    callback member-clicked(string);
}

export global PickerState {
    in property <bool> visible: false;
    in property <string> title;
    in property <[PickItem]> items;
    in-out property <string> filter;
    callback filter-changed(string);
    callback picked(string);
    callback cancel();
}

export global ConfirmState {
    in property <bool> visible: false;
    in property <string> title;
    in property <string> text;
    in property <string> ok-label: "OK";
    in property <bool> danger: false;
    callback ok();
    callback cancel();
}

component ChatRow inherits Rectangle {
    in property <ChatItem> item;
    callback clicked();
    callback action(string);
    height: Theme.compact ? Theme.sz(58) : Theme.sz(72);
    background: item.selected ? Theme.selected : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    ContextMenuArea {
        Menu {
            if item.unread: MenuItem { title: "Mark as read"; activated => { root.action("read"); } }
            if item.can-pin && !item.pinned: MenuItem { title: "Pin chat"; activated => { root.action("pin"); } }
            if item.can-pin && item.pinned: MenuItem { title: "Unpin chat"; activated => { root.action("unpin"); } }
            if item.can-archive && !item.archived: MenuItem { title: "Archive chat"; activated => { root.action("archive"); } }
            if item.can-archive && item.archived: MenuItem { title: "Unarchive chat"; activated => { root.action("unarchive"); } }
            MenuItem { title: "Chat info"; activated => { root.action("info"); } }
            MenuSeparator { }
            MenuItem { title: "Delete chat"; activated => { root.action("delete"); } }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Avatar {
            y: (parent.height - self.height) / 2;
            size: Theme.compact ? Theme.sz(40) : Theme.sz(46);
            initials: item.initials;
            avatar-color: item.avatar-color;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.compact ? 1px : 4px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.name;
                    font-size: Theme.fs(15);
                    font-weight: 600;
                    overflow: elide;
                    color: item.selected ? Theme.text-on-selected : Theme.text;
                    horizontal-stretch: 1;
                }
                if item.muted: Text { text: "🔕"; font-size: Theme.fs(11); vertical-alignment: center; }
                if item.archived: Text { text: "🗄"; font-size: Theme.fs(11); vertical-alignment: center; }
                Text {
                    text: item.time;
                    font-size: Theme.fs(12);
                    vertical-alignment: center;
                    color: item.selected ? Theme.text-on-selected : (item.unread && !item.muted ? Theme.accent : Theme.text-muted);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.typing ? "typing…" : item.preview;
                    font-size: Theme.fs(13.5);
                    overflow: elide;
                    font-italic: item.typing;
                    color: item.selected ? Theme.text-on-selected : (item.typing ? Theme.accent : Theme.text-muted);
                    horizontal-stretch: 1;
                }
                if item.pinned && !item.unread: Text { text: "📌"; font-size: Theme.fs(11); vertical-alignment: center; }
                if item.unread: Rectangle {
                    min-width: Theme.sz(22);
                    height: Theme.sz(22);
                    border-radius: self.height / 2;
                    background: item.selected ? white : (item.muted ? Theme.badge-muted : Theme.badge);
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: item.unread-count > 0 ? item.unread-count : "";
                            font-size: Theme.fs(12);
                            font-weight: 600;
                            color: item.selected ? Theme.selected : white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

component DateChip inherits Rectangle {
    in property <string> text;
    height: Theme.sz(40);
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: chip-label.preferred-width + 24px;
        height: Theme.sz(24);
        border-radius: self.height / 2;
        background: Theme.dark ? #1e2c3a : #ffffffcc;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            chip-label := Text {
                text: root.text;
                font-size: Theme.fs(12.5);
                font-weight: 500;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
}

component MessageBubble inherits Rectangle {
    in property <MsgItem> item;
    in property <length> max-bubble-width;
    // own bubbles can have a custom colour, so their text colour follows that
    property <color> fg: item.outgoing ? Theme.bubble-out-text : Theme.bubble-text;
    property <color> fg-muted: item.outgoing ? Theme.bubble-out-muted : Theme.text-muted;
    callback action(string /* action */);
    callback react(string /* emoji */);

    height: row.preferred-height;
    background: item.highlight ? Theme.highlight : transparent;
    animate background { duration: 400ms; }

    row := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: item.group-start ? 6px : 1px;
        padding-bottom: 1px;
        alignment: item.outgoing ? end : start;

        bubble := Rectangle {
            max-width: root.max-bubble-width;
            // stickers float without a bubble, like in WhatsApp
            property <bool> bare: item.is-sticker && item.text == "" && !item.quoted-id-visible;
            background: bare ? transparent : item.outgoing ? Theme.bubble-out : Theme.bubble-in;
            border-radius: Theme.radius;
            drop-shadow-blur: bare ? 0px : 1px;
            drop-shadow-color: #00000018;
            drop-shadow-offset-y: 1px;

            ContextMenuArea {
                Menu {
                    MenuItem { title: "Reply"; activated => { root.action("reply"); } }
                    MenuItem { title: "React…"; activated => { root.action("react"); } }
                    MenuItem { title: "Forward…"; activated => { root.action("forward"); } }
                    MenuItem { title: "Copy text"; activated => { root.action("copy"); } }
                    if item.has-link: MenuItem { title: "Open link"; activated => { root.action("link"); } }
                    if item.has-link: MenuItem { title: "Copy link"; activated => { root.action("copy-link"); } }
                    if item.outgoing && !item.has-file: MenuItem { title: "Edit"; activated => { root.action("edit"); } }
                    if item.can-pin && !item.pinned: MenuItem { title: "Pin message"; activated => { root.action("pin"); } }
                    if item.can-pin && item.pinned: MenuItem { title: "Unpin message"; activated => { root.action("unpin"); } }
                    if item.has-file && item.file-status == 1: MenuItem { title: "Open file"; activated => { root.action("open"); } }
                    if item.has-file && item.file-status == 1: MenuItem { title: "Open with…"; activated => { root.action("open-with"); } }
                    if item.has-file && item.file-status == 1: MenuItem { title: "Save as…"; activated => { root.action("save"); } }
                    if item.has-file && item.file-status == 1: MenuItem { title: "Show in folder"; activated => { root.action("show"); } }
                    if item.has-file && item.file-status != 1 && item.file-available: MenuItem { title: "Download"; activated => { root.action("download"); } }
                    MenuSeparator {}
                    MenuItem { title: "👍"; activated => { root.react("👍"); } }
                    MenuItem { title: "❤️"; activated => { root.react("❤️"); } }
                    MenuItem { title: "😂"; activated => { root.react("😂"); } }
                    MenuItem { title: "😮"; activated => { root.react("😮"); } }
                    MenuItem { title: "😢"; activated => { root.react("😢"); } }
                    MenuItem { title: "🙏"; activated => { root.react("🙏"); } }
                    MenuItem { title: "Remove reaction"; activated => { root.react(""); } }
                    MenuSeparator {}
                    MenuItem { title: "Delete"; activated => { root.action("delete"); } }
                }
            }

            content := VerticalLayout {
                padding: 8px;
                padding-left: 11px;
                padding-right: 11px;
                spacing: 4px;

                if item.show-sender: Text {
                    text: item.sender;
                    font-size: Theme.fs(13);
                    font-weight: 600;
                    color: item.sender-color;
                    overflow: elide;
                }

                if item.quoted-id-visible: Rectangle {
                    background: qta.has-hover ? Theme.quote-bg.darker(10%) : Theme.quote-bg;
                    border-radius: 8px;
                    qta := TouchArea { mouse-cursor: pointer; clicked => { root.action("jump-quoted"); } }
                    HorizontalLayout {
                        Rectangle { width: 3px; background: Theme.accent; border-radius: 2px; }
                        VerticalLayout {
                            padding: 6px;
                            padding-left: 8px;
                            spacing: 2px;
                            Text { text: item.quoted-sender; font-size: Theme.fs(12.5); font-weight: 600; color: Theme.accent; overflow: elide; }
                            Text { text: item.quoted-text; font-size: Theme.fs(13); color: root.fg-muted; overflow: elide; }
                        }
                    }
                }

                if item.is-image && item.file-status == 1 && !item.is-sticker: Image {
                    source: item.image;
                    image-fit: contain;
                    max-width: min(320px, root.max-bubble-width - 22px);
                    max-height: 320px;
                    preferred-width: min(320px, root.max-bubble-width - 22px);
                    preferred-height: self.preferred-width * self.source.height / max(1, self.source.width);
                    TouchArea { mouse-cursor: pointer; clicked => { root.action("open"); } }
                }
                if item.is-sticker && item.file-status == 1: Image {
                    source: item.image;
                    image-fit: contain;
                    width: Theme.sz(160);
                    height: Theme.sz(160);
                }

                if item.has-file && item.file-kind == 2 && item.file-available: Rectangle {
                    background: Theme.quote-bg;
                    border-radius: 8px;
                    min-width: Theme.sz(260);
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        // play / pause
                        Rectangle {
                            width: Theme.sz(38);
                            height: Theme.sz(38);
                            y: (parent.height - self.height) / 2;
                            border-radius: self.width / 2;
                            background: pta.has-hover ? Theme.accent.darker(10%) : Theme.accent;
                            // play / pause drawn as shapes (glyphs would come from the emoji font)
                            if item.audio-state == 1: Path {
                                width: parent.width * 0.36;
                                height: parent.height * 0.4;
                                viewbox-width: 10;
                                viewbox-height: 12;
                                fill: white;
                                commands: "M 0 0 L 3.5 0 L 3.5 12 L 0 12 Z M 6.5 0 L 10 0 L 10 12 L 6.5 12 Z";
                            }
                            if item.audio-state != 1 && item.audio-state != 3 && item.file-status != 2: Path {
                                x: parent.width * 0.36;
                                width: parent.width * 0.36;
                                height: parent.height * 0.42;
                                viewbox-width: 10;
                                viewbox-height: 12;
                                fill: white;
                                commands: "M 0 0 L 10 6 L 0 12 Z";
                            }
                            if item.audio-state == 3 || item.file-status == 2: Text {
                                text: "⋯";
                                color: white;
                                font-size: Theme.fs(18);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            pta := TouchArea { mouse-cursor: pointer; clicked => { root.action("play"); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            horizontal-stretch: 1;
                            // progress bar, click to seek
                            Rectangle {
                                height: 14px;
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: root.fg-muted.with-alpha(0.35);
                                }
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width * item.audio-progress;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                }
                                Rectangle {
                                    x: parent.width * item.audio-progress - self.width / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    border-radius: 6px;
                                    background: Theme.accent;
                                }
                                sta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action("seek:" + (self.mouse-x / self.width)); }
                                }
                            }
                            HorizontalLayout {
                                Text { text: item.audio-time != "" ? item.audio-time : item.file-note; font-size: Theme.fs(12); color: root.fg-muted; horizontal-stretch: 1; overflow: elide; }
                                if item.audio-state == 1 || item.audio-state == 2: Rectangle {
                                    width: Theme.sz(34);
                                    height: Theme.sz(18);
                                    border-radius: self.height / 2;
                                    background: spa.has-hover ? Theme.accent.with-alpha(0.3) : Theme.accent.with-alpha(0.18);
                                    Text { text: item.audio-speed; font-size: Theme.fs(11); font-weight: 600; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                                    spa := TouchArea { mouse-cursor: pointer; clicked => { root.action("speed"); } }
                                }
                            }
                        }
                    }
                }

                if item.has-file && !(item.is-image && item.file-status == 1) && !(item.file-kind == 2 && item.file-available): Rectangle {
                    background: fta.has-hover && item.file-available ? Theme.quote-bg.darker(10%) : Theme.quote-bg;
                    border-radius: 8px;
                    min-width: Theme.sz(240);
                    fta := TouchArea {
                        mouse-cursor: item.file-available ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.action(item.file-status == 1 ? "open" : "download"); }
                    }
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        Rectangle {
                            width: Theme.sz(38);
                            height: Theme.sz(38);
                            border-radius: self.width / 2;
                            background: item.file-available ? Theme.accent : Theme.badge-muted;
                            Text {
                                text: item.file-status == 2 ? "⏳"
                                    : item.file-status == 1 ? (item.file-kind == 2 || item.file-kind == 3 ? "▶" : item.file-kind == 1 ? "🖼" : "📄")
                                    : item.file-available ? "⬇" : "✕";
                                color: white;
                                font-size: Theme.fs(16);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: item.file-name; font-size: Theme.fs(13.5); color: root.fg; overflow: elide; }
                            Text { text: item.file-note; font-size: Theme.fs(12); color: root.fg-muted; wrap: word-wrap; }
                        }
                    }
                }

                if item.deleted: Text {
                    text: "🚫 This message was deleted";
                    font-size: Theme.fs(14.5);
                    font-italic: true;
                    color: root.fg-muted;
                }
                if item.text != "" && !item.deleted: StyledText {
                    text: item.rich;
                    default-color: root.fg;
                    default-font-size: Theme.fs(14.5);
                    link-color: item.outgoing && Theme.bubble-out-dark ? #8cc8ff : Theme.dark ? #6ab3f8 : #1a5fd0;
                    selectable: true;
                    link-clicked(url) => { root.action("url:" + url); }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 4px;
                    if item.reactions != "": Rectangle {
                        border-radius: 10px;
                        background: Theme.quote-bg;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text { text: item.reactions; font-size: Theme.fs(12.5); color: root.fg; vertical-alignment: center; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if item.pinned: Text { text: "📌"; font-size: Theme.fs(10.5); vertical-alignment: center; }
                    if item.edited: Text { text: "edited"; font-size: Theme.fs(11); color: root.fg-muted; vertical-alignment: center; }
                    Text { text: item.time; font-size: Theme.fs(11); color: root.fg-muted; vertical-alignment: center; }
                    if item.outgoing: Text {
                        text: item.status == 2 ? "✓✓" : "✓";
                        font-size: Theme.fs(11);
                        font-weight: 700;
                        color: item.status == 2 ? Theme.read-tick : root.fg-muted;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export struct EmojiRow {
    cells: [string],
}

export global EmojiState {
    in property <[EmojiRow]> rows;
    in property <[string]> tabs;
    in-out property <int> tab: 1;
    in-out property <string> search;
    // false: insert into the composer, true: react to a message
    in property <bool> react-mode: false;
    in property <bool> limited: false;
    callback tab-changed(int);
    callback search-changed(string);
    callback picked(string);
}

component EmojiPanel inherits PopupWindow {
    close-policy: close-on-click-outside;
    width: 9 * 40px + 24px;
    height: 400px;
    MenuSurface {
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            if !EmojiState.limited: Rectangle {
                height: 34px;
                border-radius: 17px;
                background: Theme.input-bg;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Text { text: "🔍"; font-size: 12px; vertical-alignment: center; horizontal-stretch: 0; }
                    emoji-search := TextInput {
                        horizontal-stretch: 1;
                        text <=> EmojiState.search;
                        font-size: Theme.fs(13.5);
                        color: Theme.text;
                        single-line: true;
                        vertical-alignment: center;
                        edited => { EmojiState.search-changed(self.text); }
                        Text {
                            visible: emoji-search.text == "";
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: "Search emoji (e.g. heart, laugh, flag)";
                            color: Theme.text-muted;
                            font-size: Theme.fs(13.5);
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if !EmojiState.limited && EmojiState.search == "": HorizontalLayout {
                spacing: 2px;
                for t[i] in EmojiState.tabs: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: i == EmojiState.tab ? Theme.accent.with-alpha(0.18) : (tta.has-hover ? Theme.hover : transparent);
                    Text { text: t; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { EmojiState.tab = i; EmojiState.tab-changed(i); } }
                }
            }
            if EmojiState.rows.length == 0: Text {
                text: EmojiState.tab == 0 && EmojiState.search == "" ? "Emoji you use will show up here" : "No emoji found";
                color: Theme.text-muted;
                font-size: Theme.fs(13);
                horizontal-alignment: center;
            }
            ListView {
                vertical-stretch: 1;
                for row in EmojiState.rows: HorizontalLayout {
                    height: 40px;
                    alignment: start;
                    for e in row.cells: Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        background: eta.has-hover ? Theme.hover : transparent;
                        Text { text: e; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                        eta := TouchArea { mouse-cursor: pointer; clicked => { EmojiState.picked(e); } }
                    }
                }
            }
        }
    }
}

component Composer inherits Rectangle {
    in property <bool> enter-sends;
    in-out property <string> text;
    // Ctrl+V: returns true when the clipboard held files/an image (handled as attachments)
    callback paste-attachments() -> bool;
    // bumped by the window to focus the input and put the cursor at the end
    in property <int> focus-token;
    changed focus-token => { root.cursor-to-end(); }
    callback send(string);
    callback edited(string);
    public function focus-input() { input.focus(); }
    public function append(s: string) { root.text += s; root.cursor-to-end(); }
    public function insert-at-cursor(s: string) {
        // TextInput has no insert API: append, which is where the cursor almost always is
        root.text += s;
        root.cursor-to-end();
    }
    public function cursor-to-end() {
        input.focus();
        input.set-selection-offsets(2147483647, 2147483647);
    }

    height: min(Theme.sz(140), max(Theme.sz(42), input.preferred-height + 20px));
    border-radius: min(self.height / 2, Theme.sz(21));
    background: Theme.input-bg;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        FocusScope {
            // Enter sends (Shift+Enter = new line), or the reverse with Ctrl+Enter sending
            capture-key-pressed(event) => {
                if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                    if (root.paste-attachments()) { return accept; }
                    return reject;
                }
                if (event.text == Key.Return) {
                    if (root.enter-sends ? !event.modifiers.shift : event.modifiers.control) {
                        if (root.text != "") { root.send(root.text); }
                        return accept;
                    }
                }
                return reject;
            }
            input := TextInput {
                text <=> root.text;
                font-size: Theme.fs(14.5);
                color: Theme.text;
                wrap: word-wrap;
                single-line: false;
                vertical-alignment: center;
                edited => { root.edited(self.text); }
                Text {
                    visible: input.text == "";
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text: "Write a message…";
                    color: Theme.text-muted;
                    font-size: Theme.fs(14.5);
                    vertical-alignment: center;
                }
            }
        }
    }
}

component InfoPanel inherits Rectangle {
    background: Theme.panel-bg;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-left: 16px;
            height: Theme.sz(62);
            Text { text: InfoState.is-group ? "Group info" : "Contact info"; font-size: Theme.fs(16); font-weight: 600; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: "✕"; tooltip: "Close"; clicked => { InfoState.close(); } }
        }
        Rectangle { height: 1px; background: Theme.divider; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Avatar { size: Theme.sz(110); initials: InfoState.initials; avatar-color: InfoState.avatar-color; }
                }
                Text { text: InfoState.name; font-size: Theme.fs(20); font-weight: 700; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                if InfoState.subtitle != "": Text { text: InfoState.subtitle; font-size: Theme.fs(13.5); color: Theme.text-muted; horizontal-alignment: center; }
                Rectangle { height: 1px; background: Theme.divider; }
                if InfoState.phone != "": VerticalLayout {
                    Text { text: "Phone"; font-size: Theme.fs(12); color: Theme.text-muted; }
                    Text { text: InfoState.phone; font-size: Theme.fs(14.5); color: Theme.text; }
                }
                VerticalLayout {
                    Text { text: "ID"; font-size: Theme.fs(12); color: Theme.text-muted; }
                    Text { text: InfoState.id; font-size: Theme.fs(12.5); color: Theme.text; wrap: word-wrap; }
                }
                VerticalLayout {
                    Text { text: "Account"; font-size: Theme.fs(12); color: Theme.text-muted; }
                    Text { text: InfoState.account; font-size: Theme.fs(14); color: Theme.text; }
                }
                Text {
                    text: "Profile photos and \"about\" texts aren't shown: nchat doesn't fetch them.";
                    font-size: Theme.fs(12);
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Rectangle { height: 1px; background: Theme.divider; }
                VerticalLayout {
                    MenuRow { icon: "🔍"; text: "Search in chat"; clicked => { InfoState.action("search"); } }
                    if InfoState.can-pin-message: MenuRow { icon: "📌"; text: "Go to pinned message"; clicked => { InfoState.action("jump-pinned"); } }
                    if InfoState.media-count > 0: MenuRow { icon: "📁"; text: InfoState.media-count + " files in loaded messages"; clicked => { InfoState.action("media"); } }
                    if InfoState.can-pin: MenuRow { icon: "📌"; text: InfoState.pinned ? "Unpin chat" : "Pin chat"; clicked => { InfoState.action(InfoState.pinned ? "unpin" : "pin"); } }
                    if InfoState.can-archive: MenuRow { icon: "🗄"; text: InfoState.archived ? "Unarchive chat" : "Archive chat"; clicked => { InfoState.action(InfoState.archived ? "unarchive" : "archive"); } }
                    MenuRow { icon: "🗑"; text: "Delete chat"; danger: true; clicked => { InfoState.action("delete"); } }
                }
                if InfoState.is-group: VerticalLayout {
                    spacing: 4px;
                    Rectangle { height: 1px; background: Theme.divider; }
                    Text { text: InfoState.members.length > 0 ? InfoState.members.length + " members" : "Loading members…"; font-size: Theme.fs(13); font-weight: 600; color: Theme.text-muted; }
                    for m in InfoState.members: Rectangle {
                        height: Theme.sz(52);
                        background: mta.has-hover ? Theme.hover : transparent;
                        border-radius: 8px;
                        mta := TouchArea { mouse-cursor: pointer; clicked => { InfoState.member-clicked(m.key); } }
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 10px;
                            Avatar { size: Theme.sz(36); y: (parent.height - self.height) / 2; initials: m.initials; avatar-color: m.avatar-color; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: m.name; font-size: Theme.fs(14); color: Theme.text; overflow: elide; }
                                if m.subtitle != "": Text { text: m.subtitle; font-size: Theme.fs(12); color: Theme.text-muted; overflow: elide; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component PickerDialog inherits Rectangle {
    Backdrop { dismissed => { PickerState.cancel(); } }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 440px);
        height: min(parent.height - 64px, 560px);
        border-radius: 16px;
        background: Theme.panel-bg;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        clip: true;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding: 12px;
                padding-left: 18px;
                height: Theme.sz(58);
                Text { text: PickerState.title; font-size: Theme.fs(17); font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: "✕"; clicked => { PickerState.cancel(); } }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 8px;
                Rectangle {
                    height: Theme.sz(38);
                    border-radius: self.height / 2;
                    background: Theme.input-bg;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        filter-input := TextInput {
                            text <=> PickerState.filter;
                            font-size: Theme.fs(14);
                            color: Theme.text;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { PickerState.filter-changed(self.text); }
                            init => { self.focus(); }
                            Text {
                                visible: filter-input.text == "";
                                x: 0;
                                width: parent.width;
                                height: parent.height;
                                text: "Search";
                                color: Theme.text-muted;
                                font-size: Theme.fs(14);
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if PickerState.items.length == 0: Text {
                text: "Nothing found";
                color: Theme.text-muted;
                horizontal-alignment: center;
                font-size: Theme.fs(13.5);
            }
            ListView {
                vertical-stretch: 1;
                for p in PickerState.items: Rectangle {
                    height: Theme.sz(58);
                    background: pta.has-hover ? Theme.hover : transparent;
                    pta := TouchArea { mouse-cursor: pointer; clicked => { PickerState.picked(p.key); } }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        Avatar { size: Theme.sz(40); y: (parent.height - self.height) / 2; initials: p.initials; avatar-color: p.avatar-color; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: p.name; font-size: Theme.fs(14.5); color: Theme.text; overflow: elide; }
                            if p.subtitle != "": Text { text: p.subtitle; font-size: Theme.fs(12.5); color: Theme.text-muted; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    Backdrop { dismissed => { ConfirmState.cancel(); } }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 420px);
        height: box.preferred-height;
        border-radius: 16px;
        background: Theme.panel-bg;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        TouchArea { }
        box := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            Text { text: ConfirmState.title; font-size: Theme.fs(17); font-weight: 700; color: Theme.text; wrap: word-wrap; }
            Text { text: ConfirmState.text; font-size: Theme.fs(14); color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                PrimaryButton { text: "Cancel"; secondary: true; clicked => { ConfirmState.cancel(); } }
                PrimaryButton { text: ConfirmState.ok-label; danger: ConfirmState.danger; clicked => { ConfirmState.ok(); } }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.unread-total > 0 ? "(" + root.unread-total + ") nchat-ui" : "nchat-ui";
    icon: @image-url("icon.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.app-bg;
    default-font-size: Theme.fs(14);
    default-font-family: Theme.font-family;

    // ---- state from Rust ----
    in property <[ChatItem]> chats;
    in property <[MsgItem]> messages;
    in property <bool> has-current: false;
    in property <string> current-title;
    in property <string> current-subtitle;
    in property <bool> current-subtitle-active: false;
    in property <string> current-initials;
    in property <color> current-color: gray;
    in property <bool> current-can-pin-message: false;
    in property <string> connection-status: "Starting…";
    in property <bool> connected: false;
    in property <bool> syncing: false;
    in property <string> reply-sender;
    in property <string> reply-text;
    in property <bool> editing: false;
    in property <string> banner-text;
    in property <string> sidebar-banner;
    in property <string> toast;
    in-out property <string> composer-text;
    in-out property <string> search-text;
    in property <int> scroll-to-bottom-token: 0;
    // scroll to a message: index into messages, bumped token
    in property <int> scroll-to-index: -1;
    in property <int> scroll-to-token: 0;
    in-out property <int> filter: 0;
    in property <int> unread-chats: 0;
    in property <int> archived-chats: 0;
    in property <int> channel-chats: 0;
    in property <int> channel-unread: 0;
    in property <int> status-people: 0;
    in property <int> status-new: 0;
    in property <bool> can-compose: true;
    in property <bool> recording: false;
    in property <string> record-time: "0:00";
    in property <float> record-level: 0;
    in property <bool> drop-hover: false;
    callback record-start();
    callback record-cancel();
    callback record-send();
    callback paste-attachments() -> bool;
    in-out property <bool> find-visible: false;
    in-out property <string> find-text;
    in property <string> find-status;
    in property <bool> enter-sends: true;
    out property <bool> at-bottom: msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 150px;
    in property <int> new-below: 0;
    in property <string> sync-detail;
    in property <int> unread-total: 0;
    callback jumped-to-bottom();

    // ---- callbacks to Rust ----
    callback chat-selected(string /* key */);
    callback chat-action(string /* key */, string /* action */);
    callback send-text(string);
    callback attach-file();
    callback load-older();
    callback message-action(string /* id */, string /* action */);
    callback message-react(string /* id */, string /* emoji */);
    callback cancel-reply();
    callback search-changed(string);
    callback filter-changed(int);
    callback composer-edited(string);
    callback toggle-theme();
    callback add-account();
    callback new-chat();
    callback open-settings();
    callback open-info();
    callback mark-all-read();
    callback find(string, bool /* older */);
    callback find-closed();
    callback jump-pinned();
    callback emoji-requested();


    function scroll-bottom() {
        msg-list.content-y = min(0px, msg-list.visible-height - msg-list.content-height);
    }
    function scroll-to-message() {
        if (root.scroll-to-index >= 0 && root.messages.length > 0) {
            msg-list.content-y = max(min(0px, msg-list.visible-height - msg-list.content-height),
                min(0px, msg-list.visible-height / 3 - msg-list.content-height * root.scroll-to-index / root.messages.length));
        }
    }

    // ListView measures rows lazily, so keep re-applying the scroll for ~0.5 s.
    property <int> settle-runs: 0;
    property <bool> settle-to-bottom: true;
    // Stick to the bottom while the user is there: new messages, decoded images and
    // lazily measured rows change the height after the first scroll.
    property <bool> follow-bottom: true;
    property <length> list-y: msg-list.content-y;
    property <length> list-h: msg-list.content-height;
    property <length> list-vh: msg-list.visible-height;
    changed list-y => {
        root.follow-bottom = msg-list.content-y <= msg-list.visible-height - msg-list.content-height + 24px;
    }
    // Offset that pushes a short chat down to the message box. Set from change handlers
    // (a direct binding would be a loop: the list's height depends on its content).
    property <length> list-top: 0px;
    property <length> list-area-h: list-area.height;
    function update-list-top() {
        // content-height includes the spacer itself
        root.list-top = max(0px, msg-list.visible-height - (msg-list.content-height - root.list-top));
    }
    changed list-area-h => { root.update-list-top(); }
    changed list-h => {
        root.update-list-top();
        if (root.follow-bottom) { root.scroll-bottom(); }
    }
    changed list-vh => { if (root.follow-bottom) { root.scroll-bottom(); } }
    changed scroll-to-bottom-token => {
        follow-bottom = true;
        settle-to-bottom = true;
        scroll-bottom();
        settle-runs = 10;
        settle-timer.running = true;
    }
    changed scroll-to-token => {
        settle-to-bottom = false;
        scroll-to-message();
        settle-runs = 10;
        settle-timer.running = true;
    }
    blink-timer := Timer {
        property <bool> on: true;
        interval: 500ms;
        running: root.recording;
        triggered => { self.on = !self.on; }
    }

    settle-timer := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            if (root.settle-to-bottom) { root.scroll-bottom(); } else { root.scroll-to-message(); }
            root.settle-runs -= 1;
            if (root.settle-runs <= 0) { self.running = false; }
        }
    }

    emoji-popup := EmojiPanel {
        x: sidebar.width + 12px;
        y: root.height - self.height - 74px;
    }
    react-popup := EmojiPanel {
        x: sidebar.width + (root.width - sidebar.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }
    public function open-emoji-panel(react: bool) {
        if (react) { react-popup.show(); } else { emoji-popup.show(); }
    }
    public function close-emoji-panels() {
        react-popup.close();
        emoji-popup.close();
    }
    property <int> composer-focus-token: 0;
    public function insert-emoji(e: string) {
        root.composer-text += e;
        root.composer-focus-token += 1;
    }
    public function focus-composer() {
        root.composer-focus-token += 1;
    }

    main-menu := PopupWindow {
        x: sidebar.width - self.width - 8px;
        y: Theme.sz(56);
        width: 240px;
        MenuSurface {
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                MenuRow { icon: "✎"; text: "New chat"; clicked => { root.new-chat(); } }
                MenuRow { icon: "＋"; text: "Add account"; clicked => { root.add-account(); } }
                MenuRow { icon: "✓"; text: "Mark all as read"; clicked => { root.mark-all-read(); } }
                MenuRow { icon: "🗄"; text: "Archived chats"; clicked => { root.filter = 3; root.filter-changed(3); } }
                MenuRow { icon: Theme.dark ? "☀" : "☾"; text: Theme.dark ? "Light theme" : "Dark theme"; clicked => { root.toggle-theme(); } }
                Rectangle { height: 1px; background: Theme.divider; }
                MenuRow { icon: "⚙"; text: "Settings"; clicked => { root.open-settings(); } }
            }
        }
    }

    HorizontalLayout {
        // ================= Sidebar =================
        sidebar := Rectangle {
            horizontal-stretch: 1;
            min-width: 280px;
            max-width: 400px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                HorizontalLayout {
                    padding: 12px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    height: Theme.sz(62);
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: "Chats"; font-size: Theme.fs(20); font-weight: 700; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: root.syncing ? Theme.accent : (root.connected ? #2ecc71 : #f39c12);
                            }
                            Text { text: root.connection-status; font-size: Theme.fs(12); color: Theme.text-muted; overflow: elide; }
                        }
                    }
                    IconButton { icon: "✎"; tooltip: "New chat"; y: (parent.height - self.height) / 2; clicked => { root.new-chat(); } }
                    IconButton { icon: "⋮"; tooltip: "Menu"; y: (parent.height - self.height) / 2; clicked => { main-menu.show(); } }
                }
                if root.syncing: VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    ProgressIndicator { indeterminate: true; height: 4px; }
                    Text { text: root.sync-detail; font-size: Theme.fs(11.5); color: Theme.text-muted; overflow: elide; }
                }
                // search
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 8px;
                    Rectangle {
                        height: Theme.sz(38);
                        border-radius: self.height / 2;
                        background: Theme.input-bg;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text { text: "🔍"; font-size: Theme.fs(13); vertical-alignment: center; color: Theme.text-muted; horizontal-stretch: 0; }
                            search-input := TextInput {
                                horizontal-stretch: 1;
                                text <=> root.search-text;
                                font-size: Theme.fs(14);
                                color: Theme.text;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.search-changed(self.text); }
                                Text {
                                    visible: search-input.text == "";
                                    x: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Search chats";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs(14);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                // filters
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 8px;
                    spacing: 6px;
                    alignment: start;
                    Chip { text: "All"; selected: root.filter == 0; clicked => { root.filter = 0; root.filter-changed(0); } }
                    Chip { text: root.unread-chats > 0 ? "Unread " + root.unread-chats : "Unread"; selected: root.filter == 1; clicked => { root.filter = 1; root.filter-changed(1); } }
                    Chip { text: "Groups"; selected: root.filter == 2; clicked => { root.filter = 2; root.filter-changed(2); } }
                    if root.channel-chats > 0 || root.filter == 4: Chip {
                        text: root.channel-unread > 0 ? "Channels " + root.channel-unread : "Channels";
                        selected: root.filter == 4;
                        clicked => { root.filter = 4; root.filter-changed(4); }
                    }
                    if root.status-people > 0 || root.filter == 5: Chip {
                        text: root.status-new > 0 ? "Status " + root.status-new : "Status";
                        selected: root.filter == 5;
                        clicked => { root.filter = 5; root.filter-changed(5); }
                    }
                    if root.archived-chats > 0 || root.filter == 3: Chip { text: "Archived " + root.archived-chats; selected: root.filter == 3; clicked => { root.filter = 3; root.filter-changed(3); } }
                }
                if root.sidebar-banner != "": Rectangle {
                    background: Theme.dark ? #3a2f12 : #fff4d6;
                    HorizontalLayout {
                        padding: 10px;
                        Text { text: root.sidebar-banner; wrap: word-wrap; font-size: Theme.fs(12.5); color: Theme.text; }
                    }
                }
                if root.chats.length == 0: VerticalLayout {
                    alignment: center;
                    padding: 24px;
                    Text {
                        text: root.filter == 1 ? "No unread chats" : root.filter == 3 ? "No archived chats"
                            : root.filter == 4 ? "No channels" : root.filter == 5 ? "No status updates in the last 24 hours"
                            : root.connected ? "No chats" : "Loading chats…";
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        font-size: Theme.fs(13.5);
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for chat in root.chats: ChatRow {
                        item: chat;
                        clicked => { root.chat-selected(chat.key); }
                        action(a) => { root.chat-action(chat.key, a); }
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.divider; }

        // ================= Conversation =================
        Rectangle {
            horizontal-stretch: 2.2;
            background: Theme.chat-bg;

            if !root.has-current: VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text { text: "💬"; font-size: 56px; horizontal-alignment: center; }
                Text { text: "Select a chat to start messaging"; font-size: Theme.fs(16); color: Theme.text-muted; horizontal-alignment: center; }
            }

            VerticalLayout {
                visible: root.has-current;
                // header
                Rectangle {
                    height: Theme.sz(62);
                    background: Theme.header-bg;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            TouchArea { mouse-cursor: pointer; clicked => { root.open-info(); } }
                            HorizontalLayout {
                                spacing: 12px;
                                Avatar { size: Theme.sz(40); y: (parent.height - self.height) / 2; initials: root.current-initials; avatar-color: root.current-color; }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: root.current-title; font-size: Theme.fs(16); font-weight: 600; color: Theme.text; overflow: elide; }
                                    if root.current-subtitle != "": Text {
                                        text: root.current-subtitle;
                                        font-size: Theme.fs(12.5);
                                        color: root.current-subtitle-active ? Theme.accent : Theme.text-muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        if root.current-can-pin-message: IconButton { icon: "📌"; tooltip: "Pinned message"; y: (parent.height - self.height) / 2; clicked => { root.jump-pinned(); } }
                        IconButton {
                            icon: "🔍";
                            tooltip: "Search in chat";
                            active: root.find-visible;
                            y: (parent.height - self.height) / 2;
                            clicked => { root.find-visible = !root.find-visible; if (!root.find-visible) { root.find-closed(); } }
                        }
                        IconButton { icon: "ⓘ"; tooltip: "Chat info"; y: (parent.height - self.height) / 2; clicked => { root.open-info(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }

                if root.find-visible: Rectangle {
                    height: Theme.sz(50);
                    background: Theme.header-bg;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: self.height / 2;
                            background: Theme.input-bg;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                find-input := TextInput {
                                    text <=> root.find-text;
                                    font-size: Theme.fs(14);
                                    color: Theme.text;
                                    single-line: true;
                                    vertical-alignment: center;
                                    init => { self.focus(); }
                                    accepted => { root.find(self.text, false); }
                                    Text {
                                        visible: find-input.text == "";
                                        x: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        text: "Search messages, press Enter";
                                        color: Theme.text-muted;
                                        font-size: Theme.fs(14);
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text { text: root.find-status; font-size: Theme.fs(12.5); color: Theme.text-muted; vertical-alignment: center; }
                        IconButton { icon: "⌃"; tooltip: "Older match"; size: Theme.sz(34); clicked => { root.find(root.find-text, true); } }
                        IconButton { icon: "✕"; tooltip: "Close search"; size: Theme.sz(34); clicked => { root.find-visible = false; root.find-closed(); } }
                    }
                }

                if root.banner-text != "": Rectangle {
                    height: Theme.sz(30);
                    background: Theme.dark ? #3a2f12 : #fff4d6;
                    Text { text: root.banner-text; font-size: Theme.fs(12.5); color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                }

                list-area := Rectangle {
                    vertical-stretch: 1;
                msg-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    for m[i] in root.messages: VerticalLayout {
                        // short chats sit at the bottom, next to the message box (like WhatsApp)
                        if i == 0 && root.list-top > 0: Rectangle { height: root.list-top; }
                        if m.kind == 1: DateChip { text: m.text; }
                        if m.kind == 2: Rectangle {
                            height: Theme.sz(44);
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 8px;
                                width: Theme.sz(170);
                                height: Theme.sz(28);
                                border-radius: self.height / 2;
                                background: lta.has-hover ? Theme.hover : Theme.header-bg;
                                Text { text: "Load older messages"; font-size: Theme.fs(12.5); color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                                lta := TouchArea { mouse-cursor: pointer; clicked => { root.load-older(); } }
                            }
                        }
                        if m.kind == 0: MessageBubble {
                            item: m;
                            max-bubble-width: min(560px, msg-list.visible-width * 0.72);
                            action(a) => { root.message-action(m.id, a); }
                            react(e) => { root.message-react(m.id, e); }
                        }
                        if i == root.messages.length - 1: Rectangle { height: 8px; }
                    }
                }
                if !root.at-bottom: Rectangle {
                    x: parent.width - self.width - 18px;
                    y: parent.height - self.height - 14px;
                    width: Theme.sz(42);
                    height: Theme.sz(42);
                    border-radius: self.width / 2;
                    background: jta.has-hover ? Theme.hover : Theme.header-bg;
                    drop-shadow-blur: 6px;
                    drop-shadow-color: #00000040;
                    Text { text: "⌄"; font-size: Theme.fs(22); color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    jta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.follow-bottom = true;
                            root.settle-to-bottom = true;
                            root.scroll-bottom();
                            root.settle-runs = 10;
                            settle-timer.running = true;
                            root.jumped-to-bottom();
                        }
                    }
                    if root.new-below > 0: Rectangle {
                        x: parent.width - self.width + 4px;
                        y: -6px;
                        min-width: Theme.sz(20);
                        height: Theme.sz(20);
                        border-radius: self.height / 2;
                        background: Theme.accent;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text { text: root.new-below; color: white; font-size: Theme.fs(11); font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                }

                if !root.can-compose: Rectangle {
                    height: Theme.sz(44);
                    background: Theme.header-bg;
                    Text {
                        text: "Status updates are view-only here. Reply from the person's chat.";
                        font-size: Theme.fs(12.5);
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.can-compose && (root.reply-text != "" || root.editing): Rectangle {
                    height: Theme.sz(52);
                    background: Theme.header-bg;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 10px;
                        Rectangle { width: 3px; height: Theme.sz(34); y: (parent.height - self.height) / 2; background: Theme.accent; border-radius: 2px; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.editing ? "Edit message" : "Reply to " + root.reply-sender; font-size: Theme.fs(12.5); font-weight: 600; color: Theme.accent; }
                            Text { text: root.reply-text; font-size: Theme.fs(13); color: Theme.text-muted; overflow: elide; }
                        }
                        IconButton { icon: "✕"; size: Theme.sz(32); y: (parent.height - self.height) / 2; clicked => { root.cancel-reply(); } }
                    }
                }

                // recording a voice note (WhatsApp style)
                if root.can-compose && root.recording: Rectangle {
                    height: Theme.sz(62);
                    background: Theme.header-bg;
                    HorizontalLayout {
                        padding: 10px;
                        padding-right: 12px;
                        spacing: 10px;
                        IconButton { icon: "🗑"; tooltip: "Delete recording"; y: (parent.height - self.height) / 2; clicked => { root.record-cancel(); } }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: self.height / 2;
                            background: Theme.input-bg;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5px;
                                    background: #e5484d;
                                    opacity: blink-timer.on ? 1 : 0.25;
                                    animate opacity { duration: 400ms; }
                                }
                                Text { text: root.record-time; font-size: Theme.fs(14.5); color: Theme.text; vertical-alignment: center; }
                                // live level meter
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width * min(1, root.record-level * 3);
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                        animate width { duration: 80ms; }
                                    }
                                }
                                Text { text: "Recording…"; font-size: Theme.fs(12.5); color: Theme.text-muted; vertical-alignment: center; }
                            }
                        }
                        IconButton {
                            icon: "➤";
                            tooltip: "Send voice note";
                            primary: true;
                            size: Theme.sz(42);
                            y: (parent.height - self.height) / 2;
                            clicked => { root.record-send(); }
                        }
                    }
                }

                if root.can-compose && !root.recording: Rectangle {
                    background: Theme.header-bg;
                    HorizontalLayout {
                        padding: 10px;
                        padding-right: 12px;
                        spacing: 6px;
                        VerticalLayout { alignment: end; IconButton { icon: "😊"; tooltip: "Emoji"; clicked => { root.emoji-requested(); } } }
                        VerticalLayout { alignment: end; IconButton { icon: "📎"; tooltip: "Attach file"; clicked => { root.attach-file(); } } }
                        composer := Composer {
                            horizontal-stretch: 1;
                            text <=> root.composer-text;
                            focus-token: root.composer-focus-token;
                            enter-sends: root.enter-sends;
                            paste-attachments => { return root.paste-attachments(); }
                            send(t) => { root.send-text(t); }
                            edited(t) => { root.composer-edited(t); }
                        }
                        VerticalLayout {
                            alignment: end;
                            if root.composer-text != "": IconButton {
                                icon: "➤";
                                tooltip: "Send";
                                primary: true;
                                size: Theme.sz(42);
                                clicked => {
                                    root.send-text(root.composer-text);
                                    root.composer-focus-token += 1;
                                }
                            }
                            // empty message box: record a voice note instead (like WhatsApp)
                            if root.composer-text == "": Rectangle {
                                width: Theme.sz(42);
                                height: Theme.sz(42);
                                border-radius: self.width / 2;
                                background: mta.has-hover ? Theme.accent.darker(10%) : Theme.accent;
                                Path {
                                    width: parent.width * 0.42;
                                    height: parent.height * 0.5;
                                    viewbox-width: 14;
                                    viewbox-height: 20;
                                    fill: white;
                                    commands: "M 7 0 C 5.3 0 4 1.3 4 3 L 4 10 C 4 11.7 5.3 13 7 13 C 8.7 13 10 11.7 10 10 L 10 3 C 10 1.3 8.7 0 7 0 Z M 1 9 L 2.5 9 L 2.5 10 C 2.5 12.5 4.5 14.5 7 14.5 C 9.5 14.5 11.5 12.5 11.5 10 L 11.5 9 L 13 9 L 13 10 C 13 13 10.8 15.6 7.8 15.9 L 7.8 18.5 L 10.5 18.5 L 10.5 20 L 3.5 20 L 3.5 18.5 L 6.2 18.5 L 6.2 15.9 C 3.2 15.6 1 13 1 10 Z";
                                }
                                mta := TouchArea { mouse-cursor: pointer; clicked => { root.record-start(); } }
                                Tooltip { text: @markdown("Record voice note"); }
                            }
                        }
                    }
                }
            }
        }

        if InfoState.visible: Rectangle { width: 1px; background: Theme.divider; }
        if InfoState.visible: InfoPanel {
            width: Theme.sz(340);
        }
    }

    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 90px;
        width: toast-text.preferred-width + 32px;
        height: toast-text.preferred-height + 18px;
        border-radius: self.height / 2;
        background: Theme.dark ? #e9edef : #222831;
        toast-text := Text { text: root.toast; color: Theme.dark ? #111b21 : white; font-size: Theme.fs(13.5); }
    }

    if root.drop-hover && root.has-current: Rectangle {
        x: sidebar.width + 1px;
        width: root.width - sidebar.width - 1px;
        background: Theme.accent.with-alpha(0.12);
        border-width: 3px;
        border-color: Theme.accent;
        border-radius: 12px;
        Text {
            text: "Drop files to send them to " + root.current-title;
            font-size: Theme.fs(18);
            font-weight: 600;
            color: Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if PickerState.visible: PickerDialog { width: root.width; height: root.height; }
    if SettingsState.visible: SettingsView { width: root.width; height: root.height; }
    if ConfirmState.visible: ConfirmDialog { width: root.width; height: root.height; }

    // account setup wizard, on top of everything
    if SetupState.visible: SetupView {
        width: root.width;
        height: root.height;
    }
}
