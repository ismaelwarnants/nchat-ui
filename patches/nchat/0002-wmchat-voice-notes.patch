+// voicenote.go
+//
+// Send recorded audio as a WhatsApp voice note ("PTT", push-to-talk) instead of an audio
+// file. A recording is marked by a sidecar file next to it, "<file>.voicenote", holding
+// JSON {"seconds": N, "waveform": [64 values 0..100]}. Voice notes must be Ogg/Opus.
+//
+// Added by nchat-ui (patches/nchat/0002-wmchat-voice-notes.patch).
+
+package main
+
+import (
+	"encoding/json"
+	"os"
+
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"google.golang.org/protobuf/proto"
+)
+
+type voiceNoteInfo struct {
+	Seconds  uint32 `json:"seconds"`
+	Waveform []int  `json:"waveform"`
+}
+
+// ApplyVoiceNote turns an AudioMessage into a voice note if filePath has a sidecar.
+func ApplyVoiceNote(filePath string, msg *waE2E.AudioMessage) {
+	data, err := os.ReadFile(filePath + ".voicenote")
+	if err != nil {
+		return
+	}
+	var info voiceNoteInfo
+	if err := json.Unmarshal(data, &info); err != nil {
+		LOG_WARNING("voice note: bad sidecar for " + filePath)
+		return
+	}
+	waveform := make([]byte, 0, len(info.Waveform))
+	for _, v := range info.Waveform {
+		if v < 0 {
+			v = 0
+		} else if v > 100 {
+			v = 100
+		}
+		waveform = append(waveform, byte(v))
+	}
+	msg.PTT = proto.Bool(true)
+	msg.Seconds = proto.Uint32(info.Seconds)
+	msg.Mimetype = proto.String("audio/ogg; codecs=opus")
+	if len(waveform) > 0 {
+		msg.Waveform = waveform
+	}
+	LOG_DEBUG("voice note: sending " + filePath + " as PTT")
+}
